# Copy to .env and fill in. Values already set in the environment win over .env.
# Every key is optional; the defaults shown are the ones siege/config.py uses.

# --- Credentials -------------------------------------------------------------
# Each is read by its provider's SDK directly. OpenAI is used by the attacker;
# Anthropic by the target, labeller and Cedar generator.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM roles (plan §2, §9.4) ---------------------------------------------
# Each role: SIEGE_<ROLE>_PROVIDER (anthropic | openai | ollama | fake), _MODEL,
# _TEMPERATURE, _EFFORT (low | medium | high | xhigh | max), _MAX_TOKENS.
# Blank or unset = use the default; `none` = don't send that parameter at all.
# The attacker model has no default: pick an OpenAI model and set it here.
SIEGE_ATTACKER_PROVIDER=openai
SIEGE_ATTACKER_MODEL=

# The target must accept temperature 0 (plan §9.4): Haiku 4.5 does, Opus 5.5 doesn't.
SIEGE_TARGET_PROVIDER=anthropic
SIEGE_TARGET_MODEL=claude-haiku-4-5
SIEGE_TARGET_TEMPERATURE=0

SIEGE_LABELLER_PROVIDER=anthropic
SIEGE_LABELLER_MODEL=claude-haiku-4-5
SIEGE_LABELLER_TEMPERATURE=0

SIEGE_CEDAR_PROVIDER=anthropic
SIEGE_CEDAR_MODEL=claude-opus-5-5
SIEGE_CEDAR_EFFORT=high

# --- Run --------------------------------------------------------------------
SIEGE_MAX_TURNS=10
SIEGE_ATTACKER_USER=alice
SIEGE_TARGET_URL=http://127.0.0.1:8100
SIEGE_RUNS_DIR=runs
# SIEGE_DB_PATH defaults to $SIEGE_RUNS_DIR/siege.db
SIEGE_DB_PATH=

# --- Local fallback provider -------------------------------------------------
OLLAMA_HOST=http://localhost:11434
