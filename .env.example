# Copy to .env to override defaults. Values already set in the environment win over .env.
# Every key is optional: with no .env at all, Siege runs fully on local Ollama.

# --- LLM roles (plan §2, §9.4) ---------------------------------------------
# Default: every role uses local Ollama with one shared model (no API key needed).
# Each role: SIEGE_<ROLE>_PROVIDER (ollama | anthropic | openai | fake), _MODEL,
# _TEMPERATURE, _EFFORT (low | medium | high | xhigh | max; cloud models only), _MAX_TOKENS.
# Blank or unset = use the default; `none` = don't send that parameter at all.
SIEGE_ATTACKER_PROVIDER=ollama
SIEGE_ATTACKER_MODEL=qwen2.5:7b

SIEGE_TARGET_PROVIDER=ollama
SIEGE_TARGET_MODEL=qwen2.5:7b
SIEGE_TARGET_TEMPERATURE=0

SIEGE_LABELLER_PROVIDER=ollama
SIEGE_LABELLER_MODEL=qwen2.5:7b
SIEGE_LABELLER_TEMPERATURE=0

# The Cedar generator tries these models in order until a policy passes validation
# and the goal's decision tests (plan §6.5). Pull both: `ollama pull qwen2.5:14b`.
# Setting only SIEGE_CEDAR_MODEL instead runs a one-model cascade.
SIEGE_CEDAR_PROVIDER=ollama
SIEGE_CEDAR_MODELS=qwen2.5:7b,qwen2.5:14b
SIEGE_CEDAR_TEMPERATURE=0

OLLAMA_HOST=http://localhost:11434

# --- Optional cloud providers --------------------------------------------------
# Only needed if you switch a role to anthropic or openai above.
# Install the extra first: pip install -e '.[cloud]'
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Run --------------------------------------------------------------------
SIEGE_MAX_TURNS=10
SIEGE_ATTACKER_USER=alice
SIEGE_TARGET_URL=http://127.0.0.1:8100
SIEGE_RUNS_DIR=runs
# SIEGE_DB_PATH defaults to $SIEGE_RUNS_DIR/siege.db
SIEGE_DB_PATH=
